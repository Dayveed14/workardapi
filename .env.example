NODE_ENV=development
PORT=5000
# All dates/times (late clock-ins, "today") are worked out in this timezone
APP_TIMEZONE=Africa/Lagos

# Frontend origin(s), comma separated, no trailing slash
CLIENT_URL=http://localhost:5173

# MySQL (XAMPP, TiDB Cloud, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workard
# true for TiDB Cloud / managed MySQL that requires TLS
DB_SSL=false

# JWT — generate each with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7

# Cookies: frontend (Vercel) and API (Render) on different domains → none (HTTPS only)
COOKIE_SAMESITE=lax

# Resend (emails: 2FA codes, password reset, invites)
# If RESEND_API_KEY is empty in development, emails are printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM=Workard <noreply@fixer.com>

# Cloudinary (employee documents & photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=workard

# ---------- Phase 3: payroll ----------
# Encrypts each business's Paystack secret key in the database. 64 hex characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe and never change it once businesses have connected Paystack.
ENCRYPTION_KEY=

# The public address of THIS API (used to show businesses their Paystack webhook URL)
API_PUBLIC_URL=http://localhost:5000

# Leave as is. (The test script points this at a fake Paystack.)
PAYSTACK_BASE_URL=https://api.paystack.co

# ---------- Tasks: daily jobs ----------
# The server makes repeating tasks and sends the morning task email by itself every 15 minutes.
# If your host puts the server to sleep (e.g. Render free), ALSO call this every morning
# from a free cron service (cron-job.org):  POST <API_PUBLIC_URL>/api/jobs/daily
# with header  x-cron-secret: <CRON_SECRET>.  Long random text; empty = endpoint switched off.
CRON_SECRET=

# ---------- Hosting ----------
# How many proxies are in front of the API, so it sees each visitor's real IP
# (used by the office Wi-Fi clock-in check and login rate limits):
#   1 = browsers call Render directly (api.workard.com or the onrender.com address)
#   2 = browsers call workard.com/api and Vercel forwards to Render (client/vercel.json rewrite)
TRUST_PROXY=1

# ---------- Plans & billing ----------
# Switch for paid plans. false (default) = Workard is free for everyone (early access, no plan picker).
# true = new organisations get a free trial of their plan (TRIAL_DAYS), then pay.
BILLING_ENABLED=false
TRIAL_DAYS=14
# The day you switch billing on (YYYY-MM-DD). Organisations that signed up while it was free get their
# trial counted from this date instead of their sign-up date.
BILLING_START_DATE=
# WORKARD'S OWN Paystack secret key — organisations pay their yearly plan (Starter/Business/Enterprise) into it.
# Use sk_test_... while testing (Paystack test cards), sk_live_... in production.
# In the Paystack dashboard set the webhook URL to:  <API_PUBLIC_URL>/api/webhooks/paystack-billing
PAYSTACK_SECRET_KEY=

# ---------- Video meetings (LiveKit) ----------
# Create a project at https://cloud.livekit.io (free tier) and copy these from its Settings → Keys.
# Empty = meetings can be scheduled, but "Join" says video isn't set up yet.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
